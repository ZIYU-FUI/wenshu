+      - type: textarea
+        id: literature_gap
+        label: 文献缺口 / 局限
+        required: true
+      - type: text
+        id: research_question
+        label: 研究问题 / 假设
+        required: true
+      - type: textarea
+        id: contribution
+        label: 本研究贡献
+
+  - id: methods
+    title: M · Methods 方法
