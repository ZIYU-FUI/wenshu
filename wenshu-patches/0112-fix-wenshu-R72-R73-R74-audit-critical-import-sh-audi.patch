-        "WENSHU_DASHBOARD_BASIC_AUTH_PASSWORD", section, "password"
-    )
-    ttl_raw = _resolve(
-        "WENSHU_DASHBOARD_BASIC_AUTH_TTL_SECONDS", section, "session_ttl_seconds"
-    )
-
-    if not username:
-        LAST_SKIP_REASON = (
-            "dashboard.basic_auth.username is not set (and "
-            "WENSHU_DASHBOARD_BASIC_AUTH_USERNAME is empty). Set a username "
-            "and a password (or password_hash) under dashboard.basic_auth in "
-            "config.yaml to enable username/password dashboard login, or use "
