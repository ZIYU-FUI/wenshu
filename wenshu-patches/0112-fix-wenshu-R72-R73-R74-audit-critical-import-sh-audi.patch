-        try:
-            response = httpx.post(
-                self._token_url,
-                data={
-                    "grant_type": "authorization_code",
-                    "code": code,
-                    "redirect_uri": redirect_uri,
-                    "client_id": self._client_id,
-                    "code_verifier": code_verifier,
-                },
-                headers={"Accept": "application/json"},
-                timeout=_TOKEN_ENDPOINT_TIMEOUT_SEC,
-            )
