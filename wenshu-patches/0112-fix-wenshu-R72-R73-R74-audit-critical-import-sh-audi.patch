-            self._jwks_client = PyJWKClient(
-                self._jwks_url,
-                cache_keys=True,
-                lifespan=_JWKS_CACHE_SECONDS,
-            )
-        return self._jwks_client
-
-    def _verify_jwt(self, access_token: str) -> Dict[str, Any]:
