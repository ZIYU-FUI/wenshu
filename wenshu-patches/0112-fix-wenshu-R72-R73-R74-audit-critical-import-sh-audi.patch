-    env = os.environ.get("WENSHU_DASHBOARD_PORTAL_URL", "").strip()
-    if env:
-        return env
-    cfg_value = str(
-        _load_config_oauth_section().get("portal_url", "")
-    ).strip()
-    return cfg_value or _DEFAULT_PORTAL_URL
