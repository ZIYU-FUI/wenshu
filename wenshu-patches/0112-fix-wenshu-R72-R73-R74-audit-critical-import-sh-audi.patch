-            claims = jwt.decode(
-                access_token,
-                signing_key.key,
-                algorithms=["RS256"],
-                # Contract C2: aud is the bare client_id.
-                audience=self._client_id,
-                # Contract: issuer is the Portal base URL.
-                issuer=self._portal_url,
