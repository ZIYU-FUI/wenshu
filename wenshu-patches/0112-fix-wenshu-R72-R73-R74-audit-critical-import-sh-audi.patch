-            user_id=user_id,
-            email="",
-            display_name="",
-            org_id=str(claims.get("org_id") or ""),
-            provider=self.name,
-            expires_at=int(claims["exp"]),
-            access_token=access_token,
-            refresh_token=refresh_token,
-        )
