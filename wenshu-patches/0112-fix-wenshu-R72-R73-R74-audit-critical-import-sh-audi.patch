-
-
-# ---------------------------------------------------------------------------
-# Helpers
-# ---------------------------------------------------------------------------
-
-
-def _b64url_no_pad(raw: bytes) -> str:
-    """Base64url-encode without ``=`` padding (RFC 7636 §4)."""
-    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()
