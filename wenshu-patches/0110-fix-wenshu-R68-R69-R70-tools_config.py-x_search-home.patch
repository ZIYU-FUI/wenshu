-_PW_RATE_MAX_ATTEMPTS = 10
-_PW_RATE_WINDOW_SEC = 60.0
-_pw_attempts: Dict[str, Deque[float]] = defaultdict(deque)
-_pw_attempts_lock = threading.Lock()
