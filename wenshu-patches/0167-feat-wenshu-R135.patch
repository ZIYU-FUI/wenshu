diff --git a/apps/desktop/electron/mkdir-project.ts b/apps/desktop/electron/mkdir-project.ts
new file mode 100644
index 000000000..69f145874
--- /dev/null
+++ b/apps/desktop/electron/mkdir-project.ts
@@ -0,0 +1,86 @@
+import fs from 'node:fs'
+import path from 'node:path'
+
+import { ipcMain } from 'electron'
+
+// Replace whitespace, path separators, and control characters in a project
+// name with `_` so the result is safe to splice directly into a filesystem
+// path. Empty / whitespace-only names collapse to "project" so the caller
+// always gets a non-empty segment.
+function sanitizeProjectName(name: string): string {
+  let cleaned = String(name || '')
+    .replace(/[\s/\\<>:"|?*]+/g, '_')
+    .replace(/^\.+/, '')
+    .replace(/\.+$/, '')
+
+  if (!cleaned) {
+    cleaned = 'project'
+  }
+
+  return cleaned
+}
+
+// Compose the absolute directory where the project should live. Trailing
+// slashes on the parent are normalized so we always produce a clean path.
+function composeTargetDir(parentDir: string, sanitizedName: string): string {
+  const parent = String(parentDir || '').replace(/[\\/]+$/, '')
+
+  return path.join(parent, sanitizedName)
+}
+
+// Pick a non-conflicting target under `parentDir`. If
+// `<parentDir>/<sanitizedName>` already exists, try `-2`, `-3`, ... up to a
+// hard cap so the loop is bounded even on a polled filesystem that keeps
+// racing with the caller.
+function resolveConflictPath(parentDir: string, sanitizedName: string): string {
+  const base = composeTargetDir(parentDir, sanitizedName)
+
+  if (!fs.existsSync(base)) {
+    return base
+  }
+
+  for (let suffix = 2; suffix <= 1000; suffix += 1) {
+    const candidate = composeTargetDir(parentDir, `${sanitizedName}-${suffix}`)
+
+    if (!fs.existsSync(candidate)) {
+      return candidate
+    }
+  }
+
+  throw new Error('Could not find an available project folder suffix')
+}
+
+// Main-process entry point used by the new-project dialog. Sanitizes the name,
+// picks a non-conflicting path under `parentDir`, creates it recursively, and
+// returns the absolute path that actually landed on disk.
+export async function mkdirProjectFolder(
+  parentDir: string,
+  projectName: string
+): Promise<string> {
+  const trimmedParent = String(parentDir || '').trim()
+
+  if (!trimmedParent) {
+    throw new Error('Project parent directory is required')
+  }
+
+  const sanitized = sanitizeProjectName(projectName)
+  const target = resolveConflictPath(trimmedParent, sanitized)
+
+  await fs.promises.mkdir(target, { recursive: true })
+
+  return target
+}
+
+// Register the IPC handler. Called from `electron/main.ts` once at startup;
+// the renderer reaches the helper via the preload bridge as
+// `wenshuDesktop.mkdirProjectFolder`.
+export function installMkdirProjectIpc(): void {
+  ipcMain.handle('wenshu:fs:mkdir-project', async (_event, parentDir, projectName) => {
+    const target = await mkdirProjectFolder(
+      String(parentDir || ''),
+      String(projectName || '')
+    )
+
+    return { path: target }
+  })
+}
