R92 commit 漏改 2 处 R74 死代码:
- line 573: return await gated_auth_middleware()  (没 import, 跑 NameError)
- line 610: return await token_auth_middleware()  (没 import, 跑 NameError)

R93 修:
- 2 处 改 return await call_next() (skip auth gate)
- 验 python3 -m py_compile exit 0

PM-direct 兜底 (前 R92 派单自验不彻底).
---
 wenshu_cli/web_server.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/wenshu_cli/web_server.py b/wenshu_cli/web_server.py
index dc15cbcd5..071b65c0a 100644
--- a/wenshu_cli/web_server.py
+++ b/wenshu_cli/web_server.py
@@ -570,7 +570,8 @@ async def _plugin_api_runtime_gate(request: Request, call_next):
 
 @app.middleware("http")
 async def _dashboard_auth_gate(request: Request, call_next):
-    return await gated_auth_middleware(request, call_next)
+    # R92: dashboard_auth deleted (R69). Stub - skip auth gate.
+    return await call_next(request)
 
 
 @app.middleware("http")
@@ -607,7 +608,8 @@ async def _token_auth_seam(request: Request, call_next):
     cookie/session gates skip enforcement. Non-token routes pass straight
     through untouched.
     """
-    return await token_auth_middleware(request, call_next)
+    # R92: dashboard_auth deleted (R69). Stub - skip token auth.
+    return await call_next(request)
 
 
