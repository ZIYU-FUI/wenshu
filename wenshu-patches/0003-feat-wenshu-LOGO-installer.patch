-        return home.join(".hermes");
+        return home.join(".wenshu-hermes");
     }
 
     // Last resort — current dir, almost certainly wrong but at least
     // doesn't panic.
-    PathBuf::from(".hermes")
+    PathBuf::from(".wenshu-hermes")
 }
 
