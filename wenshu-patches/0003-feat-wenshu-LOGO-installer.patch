index 9336294f0..c1ee49e8f 100644
--- a/apps/bootstrap-installer/src-tauri/Cargo.toml
+++ b/apps/bootstrap-installer/src-tauri/Cargo.toml
@@ -1,17 +1,17 @@
 [package]
-name = "hermes-bootstrap"
+name = "wenshu-setup"
 version = "0.0.1"
 description = "文枢 Setup — signed installer that drives scripts/install.ps1"
-authors = ["Nous Research <info@nousresearch.com>"]
+authors = ["文枢 Project <wenshu@wenshu.local>"]
 edition = "2021"
