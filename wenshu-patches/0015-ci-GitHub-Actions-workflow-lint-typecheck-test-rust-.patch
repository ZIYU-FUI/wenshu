+      - uses: actions/upload-artifact@v4
         with:
-          path: ci-timings-baseline.json
-          key: ci-timings-baseline-${{ github.run_id }}
+          name: wenshu-desktop-mac
+          path: apps/desktop/release/
+
+  install-sh-manifest:
+    name: Installer Manifest Smoke Test
+    runs-on: macos-latest
+    steps:
+      - uses: actions/checkout@v4
+      - run: chmod +x scripts/install.sh
+      - run: bash scripts/install.sh -Manifest 2>&1 | head -50
+      - run: bash scripts/install.sh -Manifest 2>&1 | jq '.stages | length'
