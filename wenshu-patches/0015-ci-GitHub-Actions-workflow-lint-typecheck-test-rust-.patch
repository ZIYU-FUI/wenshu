-  all-checks-pass:
-    name: All required checks pass
-    needs:
-      - tests
-      - lint
-      - js-tests
-      - docs-site
-      - history-check
-      - contributor-check
-      - uv-lockfile
-      - lockfile-diff
-      - docker-lint
-      - supply-chain
-      - osv-scanner
-      # we don't require docker to pass rn because it's so slow lol
-      # - docker
-    if: always()
