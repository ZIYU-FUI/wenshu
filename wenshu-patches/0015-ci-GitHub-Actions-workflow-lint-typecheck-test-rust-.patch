+
+  installer-build:
+    name: Installer Build (dmg)
+    runs-on: macos-latest
+    needs: [lint, typecheck, rust-check]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: pnpm/action-setup@v4
+        with:
+          version: 11
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+          cache: 'pnpm'
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          toolchain: 1.77
+      - run: pnpm install --frozen-lockfile
+      - run: cd apps/bootstrap-installer && pnpm install
+      - run: cd apps/bootstrap-installer && CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run tauri:build
+      - uses: actions/upload-artifact@v4
+        with:
+          name: wenshu-setup-dmg
+          path: apps/bootstrap-installer/src-tauri/target/release/bundle/dmg/
 
-      - name: Upload baseline to cache (main only)
