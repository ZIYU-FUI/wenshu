-```bash
-export WENSHU_NEMO_RELAY_ATOF_ENABLED=1
-export WENSHU_NEMO_RELAY_ATOF_OUTPUT_DIRECTORY=/tmp/wenshu-nemo-relay-docs/subagent/atof
-export WENSHU_NEMO_RELAY_ATOF_FILENAME=nested-subagent-atof.jsonl
-export WENSHU_NEMO_RELAY_ATOF_MODE=overwrite
-export WENSHU_NEMO_RELAY_ATIF_ENABLED=1
-export WENSHU_NEMO_RELAY_ATIF_OUTPUT_DIRECTORY=/tmp/wenshu-nemo-relay-docs/subagent/atif
