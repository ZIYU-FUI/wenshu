-
-def _utc_now_iso() -> str:
-    return datetime.now(timezone.utc).isoformat()
-
-
-def resolve_teams_pipeline_store_path(path: str | Path | None = None) -> Path:
-    if path is not None:
-        explicit = str(path).strip()
-        if explicit:
-            return Path(explicit)
