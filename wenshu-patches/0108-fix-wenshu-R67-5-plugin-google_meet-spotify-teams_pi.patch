-        normalized.append(
-            {
-                "id": _value(call, "id"),
-                "type": _value(call, "type", "function") or "function",
-                "function": {
-                    "name": _value(function, "name"),
-                    "arguments": _value(function, "arguments"),
-                },
-            }
-        )
