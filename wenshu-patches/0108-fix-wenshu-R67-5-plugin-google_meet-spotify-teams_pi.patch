-def _scope_prefix(task_id: str, session_id: str) -> str:
-    """The task/session/thread prefix shared by every trace-key shape."""
-    if task_id:
-        return f"task:{task_id}"
-    if session_id:
-        return f"session:{session_id}"
-    return f"thread:{threading.get_ident()}"
