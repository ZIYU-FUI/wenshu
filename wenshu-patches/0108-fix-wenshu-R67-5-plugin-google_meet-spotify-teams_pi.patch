-                task_id="task-thr", session_id="sess-thr", tool_call_id="",
-            )
-
-        threads = [threading.Thread(target=worker) for _ in range(n)]
-        for t in threads:
-            t.start()
-        for t in threads:
-            t.join()
-
-        # Every observation was consumed exactly once; queue is empty.
