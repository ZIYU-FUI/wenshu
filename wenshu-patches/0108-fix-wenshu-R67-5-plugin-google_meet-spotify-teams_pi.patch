-        _stdout, stderr = await proc.communicate()
-        if proc.returncode != 0:
-            detail = stderr.decode("utf-8", errors="replace").strip()
-            raise TeamsPipelineRetryableError(f"ffmpeg audio extraction failed: {detail}")
-        return audio_path
