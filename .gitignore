# SwiftPM build output
.build/

# Tool-generated artefacts (= boss 2026-09-17 OOB 'the colleague is gone,
# you own the worktree'; = these dirs/files are produced by local tools,
# not authored code; = keep them out of `git status` noise):
# (CAUTION: do NOT add inline `# comment` after the pattern — git 2.54
# on macOS does NOT strip trailing comments reliably. Use a separate
# comment line above if you want to document why.)
.repowise/
# repowise health-check cache + LLM docs index
.claude/
# Claude Code agent runtime state
.mcp.json
# MCP server registry (= regenerated per-machine)
.worktrees/
# git worktree sub-checkouts (= each WO's branch; = top-level only;
# = git internals manage the dir itself; = this rule prevents `git
# status` from listing worktrees/ as untracked when one is missing
# its git link file)
.hermes/
# Hermes agent runtime state (= cron, skills, etc.)
.scratch/
# ephemeral design notes (= per-WO ticket scratch; = legitimate
# tracked scratch assets are unaffected by .gitignore — git only
# honours ignore for untracked files; = this rule suppresses
# untracked scratch dirs like the prior colleague's
# v1.36-v1.45-arc-closure/)
# repowise LLM API keys (= boss 2026-09-16 OOB; = local-only; = do not commit)
.repowise/.env

# build-app.sh generated .app bundle (regenerate via ./Scripts/build-app.sh)
build/

# Xcode project artefacts (wenshu.xcodeproj will arrive in a later WO)
*.xcodeproj/
*.xcworkspace/

# Xcode user data + DerivedData
DerivedData/
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# SwiftPM lock file — ignored on purpose. We re-resolve on each build.
# (Per WO-001 spec; revisit if PM decides lockfile should be committed.)
Package.resolved

# macOS noise
.DS_Store
.AppleDouble
.LSOverride

# Hermes state — STATE.md, agent run history, worktree coordination
# 沿 AGENTS §14.2 自进化方法论 v0.03.0,不入 git
.hermes/STATE.md
.hermes/agents/
.hermes/runs/

# ADOPT runtime data — 项目运行时数据,沿 AGENTS §13 wenshu 项目基线
# `.ws` 单文件 = 你的项目数据,本地自管
.hilo/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Swift package download cache (alternative layout)
.swiftpm/

# 老板 临时贴图 (e.g. pasted-1787188375157.png)
pasted-*.png

# Test scratch
*.xcresult/

# swift test 临时 sandbox 文件 (v0.18 ticket 02/05/06 subagent 跑 swift test 时用 cwd + UUID 临时目录, 留项目根)
# 跟 .scratch/<feature>/ 调研目录区分: .test-* 是 sandbox 自动生成, .scratch/ 是 po main flow 调研 trace
.test-*

# wenshu .ws migration backup directories (boss 2026-08-23 ticket 014.002)
# Auto-created by WenshuWorkspaceMigrator.real() before any write.
# Per 5-layer risk defense: never auto-delete, but never git-track.
backup-pre-ws-migration-*/

# Autonomous audit log directories (sub-agent sessions)
wenshu-audit-*/

# Bonsplit external dependency probe artifact (= third-party package clone,
# NOT wenshu source per AGENTS.md §11.1 — we don't vendor third-party code).
# Only probe-report.md (= audit trail) is preserved in git (= see commit
# d326d49b3). The rest of the clone is reproducible from public github.
.scratch/2026-08-27-bonsplit-probe/BonsplitProbe/
.scratch/2026-08-27-bonsplit-probe/Example/
.scratch/2026-08-27-bonsplit-probe/Tests/
.scratch/2026-08-27-bonsplit-probe/Sources/
.scratch/2026-08-27-bonsplit-probe/www/
.scratch/2026-08-27-bonsplit-probe/CHANGELOG.md
.scratch/2026-08-27-bonsplit-probe/LICENSE
.scratch/2026-08-27-bonsplit-probe/Package.swift
.scratch/2026-08-27-bonsplit-probe/README.md
.scratch/2026-08-27-bonsplit-probe/.gitignore
