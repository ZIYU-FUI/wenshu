<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>文枢</string>
    <key>CFBundleExecutable</key>
    <string>WenshuApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon.icon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon.icon</string>
    <key>CFBundleIdentifier</key>
    <string>com.wenshu.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>文枢</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>27.0</string>
    <key>LSUIElement</key>
    <false/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <!-- v0.24 boss验收fix (Boss 8/24 OOB): .ws = wenshu 仓库 package type.
         '库应该是个包文件, 右建点会出现显示包内容' (= package, like
         .photoslibrary / .fcpbundle / .musiclibrary). Register .ws as
         exported type so Finder treats name.ws as bundle directory
         (right-click → '显示包内容' reveals contents). -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.wenshu.workspace</string>
            <key>UTTypeDescription</key>
            <string>文枢仓库</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.apple.package</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ws</string>
                </array>
            </dict>
        </dict>
    </array>
    <!-- Declare app handles .ws files (CFBundleDocumentTypes for
         document-based open / NSOpenPanel canChooseFiles + .ws) -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>文枢仓库</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.wenshu.workspace</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
