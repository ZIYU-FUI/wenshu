    "settings.memory.backend.remote.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until this is filled in, the agent keeps using local Markdown. Nothing is sent anywhere until it is."
