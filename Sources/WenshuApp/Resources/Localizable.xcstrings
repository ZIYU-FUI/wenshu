    "chat.input.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type a slash command to instruct the AI. Examples:\n\n/create-book My new novel\n/compress focus chapter 3\n/expand selected text\n/rephrase academic\n/summarize chapter 1\n\nOr just chat normally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入斜杠命令,让 AI 执行操作。例如:\n\n/create-book 我的新小说\n/compress 聚焦第 3 章\n/expand 选中文本\n/rephrase 学术\n/summarize 第 1 章\n\n也可以直接聊天。"
          }
        }
      }
    },
